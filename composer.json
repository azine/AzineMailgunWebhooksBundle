{
    "name": "azine/mailgunwebhooks-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle to capture feedback from Mailgun webhooks",
    "keywords": ["Mailgun", "mailgun.com", "transactional email", "email", "webhooks"],
    "homepage": "https://github.com/azine/AzineMailgunWebhooksBundle.git",
    "license": "MIT",
    "authors": [
        {
            "name": "Azine IT AG",
            "email": "github@azine-it.ch"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-mailparse": "*",
        "symfony/framework-bundle": "^7.4",
        "symfony/config": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/dom-crawler": "^7.4",
        "symfony/event-dispatcher": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/yaml": "^7.4",
        "symfony/process": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/translation": "^7.4",
        "twig/twig": "^3.0",
        "doctrine/orm": "^3.3",
        "doctrine/persistence": "^4.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Azine\\MailgunWebhooksBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Azine\\MailgunWebhooksBundle\\Tests\\": "Tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
