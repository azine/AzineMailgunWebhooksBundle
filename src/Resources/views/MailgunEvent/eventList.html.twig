<div class="mailgun-table-wrap">
    <table class="eventsTable mailgun-table">
        <thead>
            <tr>
                <th>Event</th>
                <th>Date (UTC)</th>
                <th>Message / recipient</th>
                <th>Details</th>
                <th>Event IP</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for eventEntry in events %}
                <tr id="event{{ eventEntry.id }}">
                    <td><span class="mailgun-event-type mailgun-event-type-{{ eventEntry.severity|default('info')|lower|replace({' ': '-'}) }}">{{ eventEntry.event }}</span></td>
                    <td class="mailgun-date">{{ eventEntry.dateTime|date('Y-m-d H:i:s', 'UTC') }}</td>
                    <td class="mailgun-message">
                        {% if eventEntry.eventTitle %}<strong>{{ eventEntry.eventTitle }}</strong>{% endif %}
                        <span>{{ eventEntry.recipient }}</span>
                    </td>
                    <td class="mailgun-description">
                        {{ eventEntry.description ?: (eventEntry.reason ?: '—') }}
                        {% if eventEntry.errorCode %}<small>Code {{ eventEntry.errorCode }}</small>{% endif %}
                    </td>
                    <td class="mailgun-date">{{ eventEntry.ip ?: '—' }}</td>
                    <td class="mailgun-actions">
                        <a href="{{ path('mailgunevent_show', {'id': eventEntry.id}) }}">View event</a>
                        {% if eventEntry.messageId %}
                            <a href="{{ path('mailgun_message_summary', {'id': eventEntry.messageId}) }}">Message</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="mailgun-empty">No events match these filters.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
