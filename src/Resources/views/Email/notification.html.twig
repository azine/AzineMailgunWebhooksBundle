{% extends '@AzineMailgunWebhooks/Email/email.base.layout.html.twig' %}
{% block content %}
<h3>{{ 'notification.spam_complaint_received' | trans }}</h3>

{{ 'notification.mailgun_spam_received' | trans }}: <a href="{{ url('mailgunevent_show', {'id': eventId}) }}">{{ url('mailgunevent_show', {'id': eventId}) }}</a>. <br/>

<h3>{{ 'notification.spam_complaint_received.support.ticket' | trans }}</h3>
{% if ticketId is defined and ticketId != '' %}
    {{ 'notification.spam_complaint_received.update.support.ticket' | trans }} ({{ ticketId }}): <a href="https://app.mailgun.com/support">Mailgun Support</a>
{% else %}
    {{ 'notification.spam_complaint_received.create.support.ticket' | trans }}: <a href="https://help.mailgun.com/hc/en-us/requests/new">Create a Mailgun support ticket</a>
{% endif %}
{% endblock content %}
