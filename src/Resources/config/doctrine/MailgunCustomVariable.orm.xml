<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
  <entity name="Azine\MailgunWebhooksBundle\Entity\MailgunCustomVariable" table="mailgun_custom_variable" repository-class="Azine\MailgunWebhooksBundle\Entity\Repositories\MailgunCustomVariableRepository">
    <id name="id" type="integer"><generator strategy="AUTO"/></id>
    <field name="eventId" column="event_id" type="integer"/>
    <field name="variableName" column="variable_name" type="string" length="255"/>
    <field name="content" type="json"/>
    <many-to-one field="event" target-entity="Azine\MailgunWebhooksBundle\Entity\MailgunEvent" inversed-by="variables">
      <join-column name="event_id" referenced-column-name="id" on-delete="CASCADE"/>
    </many-to-one>
  </entity>
</doctrine-mapping>
