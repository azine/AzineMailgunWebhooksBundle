<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
  <entity name="Azine\MailgunWebhooksBundle\Entity\MailgunAttachment" table="mailgun_attachment" repository-class="Azine\MailgunWebhooksBundle\Entity\Repositories\MailgunAttachmentRepository">
    <id name="id" type="integer"><generator strategy="AUTO"/></id>
    <field name="eventId" column="event_id" type="integer"/>
    <field name="counter" type="integer"/>
    <field name="content" type="blob"/>
    <field name="name" type="string" length="255"/>
    <field name="type" type="string" length="30"/>
    <field name="size" type="integer"/>
    <many-to-one field="event" target-entity="Azine\MailgunWebhooksBundle\Entity\MailgunEvent" inversed-by="attachments">
      <join-column name="event_id" referenced-column-name="id" on-delete="CASCADE"/>
    </many-to-one>
  </entity>
</doctrine-mapping>
